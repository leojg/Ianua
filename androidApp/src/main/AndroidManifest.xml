<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The daily rule-pack fetch from GitHub (ADR-0003). Nothing else goes out. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Package visibility (API 30+): lets the main screen show whether YouTube and the blocked
      apps are installed. Keep the blocked list in sync with rules/blocked.json
      (:androidApp:verifyBlockedPackages checks it). QUERY_ALL_PACKAGES is deliberately not
      requested.
    -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.zhiliaoapp.musically.go" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.ss.android.ugc.aweme.lite" />
        <package android:name="com.smile.gifmaker" />
        <package android:name="com.kuaishou.nebula" />
        <package android:name="com.kwai.video" />
        <package android:name="video.like" />
        <package android:name="video.like.lite" />
        <package android:name="co.triller.droid" />
        <package android:name="in.mohalla.video" />
        <package android:name="com.eterno.shortvideos" />
    </queries>

    <application
        android:name=".IanuaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ianua">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.IanuaAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
