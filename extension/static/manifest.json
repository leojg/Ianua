{
  "manifest_version": 3,
  "name": "Ianua — a door in front of Shorts",
  "short_name": "Ianua",
  "version": "0.1.0",
  "description": "Hides YouTube Shorts and puts a pause in front of them: you only get in on purpose.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "ianua.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["ianua.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "webNavigation", "alarms", "declarativeNetRequest"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["gate.html"],
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"]
    }
  ]
}
